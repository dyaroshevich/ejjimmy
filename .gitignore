# SQLite sidecars of the tracked database.db (memory MCP writes them on open)
database.db-shm
database.db-wal

# A production database dump (leads, LINE context, push subscriptions) must not travel with a repository
# that is handed to a franchisee. One was committed once and removed; read it from history if ever needed.
*.backup.gz
db_cluster-*

# service-worker build output — @ducanh2912/next-pwa writes these into public/ on every `next build`
# (dest: "public", next.config.mjs). Hand-written public/custom-sw.js and public/offline.html stay tracked.
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/fallback-*.js
public/fallback-*.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map


# QA stills + probe JSON written by scripts/landing-shots.mjs
shots/

# Python bytecode
__pycache__/

.tmp/
.vercel
.env*
# ...except the template that documents them: B5 ships one, and an example file with no secrets in it is
# the only way a fresh clone learns which variables exist.
!.env.example

# Generated production content dumps (content:export output)
content/db/
