# Every variable this app reads, in one place.
#
# Copy to `.env.local` (never commit it) and fill in the secrets. Nothing here is real — a value like
# `your-project.supabase.co` is a shape, not an address. The gates that matter run without any of this:
# `npm run lint`, `tsc`, `jest` and `npm run brand:check` need no environment at all, which is why CI can
# run them on a pull request.
#
# What DOES need values before the app is useful: Supabase (reads and writes everything), one AI provider
# (the chat), LINE (the channel Thai customers actually arrive through). Everything after that is a
# feature you can leave off.

# ---- Supabase (required) ----------------------------------------------------
# The project URL and the public anon key are shipped to the browser by design (they are row-level
# security's subject, not its bypass). The service-role key must never reach `NEXT_PUBLIC_*`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: run two brands out of one Supabase project by isolating each in its own schema.
# SUPABASE_SCHEMA=tawanpower
# NEXT_PUBLIC_SUPABASE_SCHEMA=tawanpower
# SUPABASE_STORAGE_PREFIX=tawanpower/

# ---- Where the site lives ---------------------------------------------------
# Canonical URLs, sitemap, JSON-LD and every shared link are built from this. Without it the code falls
# back to the domain in `site.config.ts`, which is the template's placeholder, not yours.
NEXT_PUBLIC_SITE_URL=https://ejjimmy.vercel.app
# Legacy alias still honoured by the proposal route (it predates NEXT_PUBLIC_SITE_URL).
# NEXT_PUBLIC_BASE_URL=https://your-domain.example
# The staff shell is served at /admin by this same deployment (no second Vercel project, no
# NEXT_PUBLIC_APP_MODE). It is protected by the Supabase session check in middleware.ts, not by a 404.
# Set this only if admin links in Telegram must point somewhere else.
# ADMIN_SITE_URL=https://your-domain.example
# Salt for the proposal ids that go into LINE messages. Changing it invalidates every link already sent.
HASHIDS_SALT=change-me-to-a-long-random-string

# ---- AI provider (one is enough) -------------------------------------------
# The chat routes try Google first, then Groq, then OpenAI; a missing key is skipped, not fatal.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ZAI_API_KEY=

# ---- LINE (the channel) -----------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# The staff member who receives lead notifications.
LINE_ADMIN_USER_ID=
# LIFF app used by the in-LINE pages (`/liff`).
NEXT_PUBLIC_LINE_LIFF_ID=
NEXT_PUBLIC_LINE_LIFF_URL=https://liff.line.me/your-liff-id

# ---- Web push ---------------------------------------------------------------
# `npx web-push generate-vapid-keys` — the public key is served to the browser, the private one is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Rate limits ------------------------------------------------------------
# Without these the limiter degrades to "no limit" and says so in the log. Chat costs money per call,
# so set them before exposing the site.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Notifications ----------------------------------------------------------
# A phone number shown to visitors as the fallback contact; the real one lives in `site.config.ts`.
NEXT_PUBLIC_SUPPORT_PHONE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Analytics and monitoring ----------------------------------------------
# Both are optional and both are silent when unset.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Solar model knobs ------------------------------------------------------
# The calculator's defaults. They are public on purpose: the browser runs the same arithmetic the
# server does, so a hidden value would produce two different quotes.
NEXT_PUBLIC_SOLAR_ELECTRICITY_RATE=4.7
NEXT_PUBLIC_SOLAR_PANEL_WATTAGE=550
NEXT_PUBLIC_SOLAR_PANEL_AREA_SQM=2.6
NEXT_PUBLIC_SOLAR_SUN_HOURS=4.5
NEXT_PUBLIC_SOLAR_SYSTEM_LOSS_FACTOR=0.8
NEXT_PUBLIC_SOLAR_PRICE_ECO_PER_KW=25000
NEXT_PUBLIC_SOLAR_PRICE_PREMIUM_PER_KW=35000

# ---- Feature flags ----------------------------------------------------------
# Hides the instalment scheme's own financing panel when the market has no such partner.
NEXT_PUBLIC_SHOW_SOFIN=false

# ---- Local tooling only (never needed in production) ------------------------
# The screenshot/probe scripts drive a local Chrome; set the path if it is not in the default location.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Only when the probes run against a hosted browser instead of the local one.
# BROWSERLESS_API_KEY=
